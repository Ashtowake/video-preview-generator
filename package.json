{
  "name": "video-preview-generator",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:notices": "node scripts/generate-third-party-notices.mjs",
    "dev:desktop": "pnpm --filter @video-preview/desktop run tauri:dev",
    "docs:api": "pnpm docs:api:rust && pnpm docs:api:ts",
    "docs:api:rust": "cargo doc --no-deps -p vpg-core -p vpg-cli",
    "docs:api:ts": "typedoc --options typedoc.json",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typedoc": "^0.28.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.6"
  }
}
