{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Preview Generator",
  "version": "0.1.0",
  "identifier": "io.github.video-preview-generator.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @video-preview/desktop dev",
    "beforeBuildCommand": "pnpm --filter @video-preview/desktop build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video Preview Generator",
        "label": "main",
        "width": 1600,
        "height": 980,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "msi", "deb", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Video",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "fileAssociations": [
      {
        "ext": ["vpg.json"],
        "mimeType": "application/json",
        "name": "Video Preview Project",
        "description": "Video Preview Generator project file"
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "REPLACE_WITH_REAL_SIGNING_KEY",
      "endpoints": [
        "https://example.invalid/releases/{{target}}/{{current_version}}"
      ]
    }
  }
}
